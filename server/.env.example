# Puerto donde correrá la API
PORT=5000

# Conexión a MongoDB LOCAL con replica set (necesario para transacciones).
# Usa 127.0.0.1 en lugar de localhost para evitar problemas de IPv6 en Windows.
MONGODB_URI=mongodb://127.0.0.1:27017/banco?replicaSet=rs0

# Origen(es) permitidos por CORS (el frontend de Vite). Varios separados por coma.
CLIENT_URL=http://localhost:5173
